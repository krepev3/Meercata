{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/container-qualification-v1.schema.json",
  "title": "Meercata disposable Debian 13 container qualification report v1",
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id",
        "version_id",
        "architecture",
        "image_digest",
        "effective_uid",
        "effective_gid"
      ],
      "properties": {
        "os_id": { "const": "debian" },
        "version_id": { "const": "13" },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "image_digest": {
          "const": "sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258"
        },
        "effective_uid": { "const": 0 },
        "effective_gid": { "const": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "package",
    "version",
    "platform",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "container-installed-qualified" },
    "package": { "const": "meercata" },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "platform": { "$ref": "#/$defs/platform" },
    "checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "details"],
        "properties": {
          "check_id": {
            "enum": [
              "platform.container",
              "package.install",
              "sysusers.apply",
              "tmpfiles.apply",
              "package.ownership",
              "launchers.execute",
              "sudoers.authorization",
              "systemd.units",
              "data.preservation"
            ]
          },
          "status": { "const": "passed" },
          "details": {
            "type": "object",
            "maxProperties": 12
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
