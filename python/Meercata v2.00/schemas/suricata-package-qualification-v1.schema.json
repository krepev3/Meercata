{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/suricata-package-qualification-v1.schema.json",
  "title": "Meercata Suricata package qualification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project_version",
    "platform",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "suricata-package-qualified" },
    "project_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.dev[0-9]+$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id",
        "version_id",
        "architecture",
        "image_digest",
        "effective_uid",
        "effective_gid"
      ],
      "properties": {
        "os_id": { "const": "debian" },
        "version_id": { "const": "13" },
        "architecture": { "const": "x86_64" },
        "image_digest": {
          "const": "sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258"
        },
        "effective_uid": { "const": 0 },
        "effective_gid": { "const": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "details"],
        "properties": {
          "check_id": {
            "enum": [
              "platform.container",
              "apt.source",
              "packages.installed",
              "packages.integrity",
              "suricata.capabilities",
              "suricata.configuration",
              "meercata.install",
              "meercata.remove"
            ]
          },
          "status": { "const": "passed" },
          "details": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
