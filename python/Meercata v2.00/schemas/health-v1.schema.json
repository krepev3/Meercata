{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/health-v1.schema.json",
  "title": "Meercata Health Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_utc",
    "generated_local",
    "mode",
    "status",
    "exit_code",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_utc": { "type": "string", "minLength": 1 },
    "generated_local": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["ids", "ips", "unknown"] },
    "status": { "enum": ["healthy", "degraded", "critical", "unknown"] },
    "exit_code": { "enum": [0, 1, 2, 3] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "required",
        "summary",
        "observed",
        "expected",
        "metrics",
        "remediation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,128}$" },
        "status": { "enum": ["healthy", "degraded", "critical", "unknown"] },
        "required": { "type": "boolean" },
        "summary": { "type": "string" },
        "observed": {},
        "expected": {},
        "metrics": { "type": "object" },
        "remediation": { "type": ["string", "null"] }
      }
    }
  }
}
