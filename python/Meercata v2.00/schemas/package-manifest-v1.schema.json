{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/package-manifest-v1.schema.json",
  "title": "Meercata production package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "version",
    "ownership",
    "files",
    "directories"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package": { "const": "meercata" },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "ownership": {
      "const": { "user": "root", "group": "root" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mode", "role"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 512,
            "pattern": "^/(etc/sudoers\\.d/meercata|usr/(bin/meercata|lib/(meercata/(bin/meercata-(helper|package-lifecycle)|python/meercata/[A-Za-z0-9_]+\\.py)|sysusers\\.d/meercata\\.conf|tmpfiles\\.d/meercata\\.conf|systemd/system/(meercata-health\\.(service|timer)|suricata\\.service\\.d/50-meercata-production\\.conf))|share/(meercata/(meercata\\.example\\.toml|apt/debian-backports\\.sources|schemas/[A-Za-z0-9_.-]+\\.json)|doc/meercata/([A-Za-z0-9_.-]+\\.md|copyright))))$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": { "enum": ["0440", "0644", "0755"] },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": {
            "enum": [
              "/usr/lib/meercata",
              "/usr/lib/meercata/bin",
              "/usr/lib/meercata/python",
              "/usr/lib/meercata/python/meercata",
              "/usr/lib/meercata/regression-packs",
              "/usr/lib/systemd/system/suricata.service.d",
              "/usr/share/meercata",
              "/usr/share/meercata/apt",
              "/usr/share/meercata/schemas",
              "/usr/share/doc/meercata"
            ]
          },
          "mode": { "const": "0755" }
        }
      }
    }
  }
}
