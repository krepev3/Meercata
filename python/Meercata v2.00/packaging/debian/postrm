#!/bin/sh
set -eu

case "${1:-}" in
    remove|purge|disappear)
        if [ -d /run/systemd/system ]; then
            /usr/bin/systemctl daemon-reload
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade)
        ;;
    *)
        echo "meercata postrm: unsupported lifecycle action" >&2
        exit 1
        ;;
esac

exit 0
