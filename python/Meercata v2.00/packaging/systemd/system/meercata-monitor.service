[Unit]
Description=Record durable Meercata health transitions
Documentation=file:/usr/share/doc/meercata/MONITORING.md
After=suricata.service meercata-suricata-ips.service

[Service]
Type=oneshot
User=meercata
Group=meercata
ExecStart=/usr/bin/meercata monitor run --json
UMask=0077
TimeoutStartSec=30s
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_AUDIT_WRITE CAP_NET_ADMIN
ReadWritePaths=/var/lib/meercata/monitor /var/log/meercata/monitor /run/meercata/monitor

# No [Install] section: the timer is the supported activation path.
