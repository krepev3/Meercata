[Unit]
Description=Record Meercata health transitions every minute
Conflicts=meercata-health.timer

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s
RandomizedDelaySec=10s
Persistent=true
Unit=meercata-monitor.service

[Install]
WantedBy=timers.target
Also=meercata-monitor-freshness.timer
