#!/bin/sh
# Source-tree launcher: verifies Python before main.py can be imported.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v python3 >/dev/null 2>&1; then
    echo "[ERR] Python 3 is not installed or is not in PATH." >&2
    echo "[SUGGEST] Debian/Ubuntu: sudo apt install python3" >&2
    echo "[SUGGEST] Fedora: sudo dnf install python3" >&2
    echo "[SUGGEST] Arch: sudo pacman -S python" >&2
    exit 1
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
    echo "[ERR] Meercata requires Python 3.10 or newer." >&2
    echo "[SUGGEST] Upgrade Python using your Linux distribution package manager." >&2
    exit 1
fi

exec python3 "$SCRIPT_DIR/main.py" "$@"
