{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/apt-repository-qualification-v1.schema.json",
  "title": "Meercata signed APT repository qualification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project_version",
    "platform",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "apt-repository-qualified" },
    "project_version": { "const": "2.0.0.dev15" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id",
        "version_id",
        "architecture",
        "image_digest",
        "effective_uid",
        "effective_gid"
      ],
      "properties": {
        "os_id": { "const": "debian" },
        "version_id": { "const": "13" },
        "architecture": { "const": "x86_64" },
        "image_digest": {
          "const": "sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258"
        },
        "effective_uid": { "const": 0 },
        "effective_gid": { "const": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "details"],
        "properties": {
          "check_id": {
            "enum": [
              "platform.container",
              "dependencies.preinstalled",
              "signing.ephemeral-key",
              "repository.metadata",
              "trust.unpinned-key-rejected",
              "trust.signature-tamper-rejected",
              "trust.package-tamper-rejected",
              "apt.install",
              "apt.upgrade",
              "apt.remove"
            ]
          },
          "status": { "const": "passed" },
          "details": { "type": "object", "minProperties": 1, "maxProperties": 16 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
