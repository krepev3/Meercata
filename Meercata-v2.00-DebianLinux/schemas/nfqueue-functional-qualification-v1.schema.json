{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/nfqueue-functional-qualification-v1.schema.json",
  "title": "Meercata live NFQUEUE functional qualification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_version", "platform", "topology", "checks", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "nfqueue-functional-qualified" },
    "project_version": { "const": "2.0.0.dev19" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_id", "version_id", "architecture", "image_digest", "effective_uid",
        "effective_gid", "interfaces", "ipv4_routes", "network_namespace",
        "capabilities", "kernel_nfqueue_backend", "isolation_profile"
      ],
      "properties": {
        "os_id": { "const": "debian" },
        "version_id": { "const": "13" },
        "architecture": { "const": "x86_64" },
        "image_digest": { "const": "sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258" },
        "effective_uid": { "const": 0 },
        "effective_gid": { "const": 0 },
        "interfaces": { "const": ["lo"] },
        "ipv4_routes": { "const": 0 },
        "network_namespace": { "type": "string", "pattern": "^net:\\[[0-9]+\\]$", "maxLength": 64 },
        "capabilities": { "const": ["CAP_NET_ADMIN", "CAP_SYS_ADMIN"] },
        "kernel_nfqueue_backend": { "const": "available-before-run" },
        "isolation_profile": { "const": "network-none with IPv4 forwarding, NET_ADMIN, SYS_ADMIN, seccomp-unconfined, apparmor-unconfined" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traffic_path", "client_namespace", "server_namespace", "gateway_interface", "queue", "fail_policy"],
      "properties": {
        "traffic_path": { "const": "client -> Meercata gateway -> server" },
        "client_namespace": { "const": "meercata-client" },
        "server_namespace": { "const": "meercata-server" },
        "gateway_interface": { "const": "lan0" },
        "queue": { "const": 42 },
        "fail_policy": { "const": "open" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "details"],
        "properties": {
          "check_id": {
            "enum": [
              "platform.namespace",
              "topology.routed",
              "suricata.nfq-capability",
              "policy.transaction-commit",
              "nfqueue.listener",
              "verdict.accept",
              "verdict.drop",
              "performance.bounded-sample",
              "fail-open.listener-loss"
            ]
          },
          "status": { "const": "passed" },
          "details": { "type": "object", "minProperties": 1, "maxProperties": 12 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
