    "project_version": {
      "const": "2.0.0.dev24"
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "tls.trusted-ca"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "delivered": true,
                "http_status": 202
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "tls.hostname-refused"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "result": "transport-error",
                "collector_requests_unchanged": true
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "auth.retired-token-refused"
