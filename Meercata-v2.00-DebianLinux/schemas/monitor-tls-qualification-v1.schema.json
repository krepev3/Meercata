              "const": "passed"
            },
            "details": {
              "const": {
                "delivered": true,
                "http_status": 200,
                "duplicates": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "outage.retry-persisted"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "retried": 1,
                "pending": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "outage.delivery-recovered"
