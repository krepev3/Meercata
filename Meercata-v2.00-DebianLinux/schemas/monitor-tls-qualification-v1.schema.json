              "const": "passed"
            },
            "details": {
              "const": {
                "result": "remote-rejected",
                "http_status": 401,
                "unauthorized": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "auth.current-token-accepted"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "delivered": true,
                "http_status": 202
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "collector.duplicate-deduplicated"
