                "pending": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "tls.ca-rotation"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "old_ca_result": "transport-error",
                "new_ca_delivered": true,
                "new_ca_http_status": 202,
                "old_ca_blocked_before_http": true
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "health.pending-healthy"
