{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meercata.local/schemas/monitor-tls-qualification-v1.schema.json",
  "title": "Meercata loopback TLS and delivery-health qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project_version",
    "checks",
    "limitations"
