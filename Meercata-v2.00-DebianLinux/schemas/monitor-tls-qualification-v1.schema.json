            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "status": "healthy",
                "exit_code": 0,
                "pending": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "health.retry-degraded"
