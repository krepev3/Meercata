            "details": {
              "const": {
                "status": "degraded",
                "exit_code": 1,
                "retrying": 1,
                "before_due_attempted": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "health.age-critical"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "status": "critical",
                "exit_code": 2,
                "oldest_pending_age_seconds": 1801,
                "recovered_exit_code": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "status",
            "details"
          ],
          "properties": {
            "check_id": {
              "const": "health.dead-letter-critical"
            },
            "status": {
              "const": "passed"
            },
            "details": {
              "const": {
                "status": "critical",
                "exit_code": 2,
                "dead_letters": 1
              }
            }
          }
        }
